# Neon Postgres connection string (use the pooled connection from the Neon dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"

# Better Auth
# Generate a secret with: npx @better-auth/cli secret  (or: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the auth client in the browser
NEXT_PUBLIC_APP_URL="http://localhost:3000"
